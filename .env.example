# Shared mark254-commerce-api backend (also serves the Fitness site).
# The browser only calls this site's own /api/*; proxy.ts forwards those to
# BACKEND_URL tagged with X-App-Key=NEXT_PUBLIC_APP_KEY, which keeps Source of
# Adventure's adventures, bookings and messages separate from other apps.
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_APP_KEY=sos
# Used for "Chat on WhatsApp" links (bookings use the number stored on the backend's app record).
NEXT_PUBLIC_WHATSAPP=254701437959
# Optional: link in the admin sidebar to the other site sharing this backend
NEXT_PUBLIC_PARTNER_ADMIN_URL=http://localhost:3000/admin
NEXT_PUBLIC_PARTNER_NAME=Marksila254 admin
